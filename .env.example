APP_MODE=production
ENABLE_TEST_SEED=false
TG_API_ID=
TG_API_HASH=
TG_PHONE=+
TG_SESSION=
MANAGE_SPEND_BOT_USERNAME=@ManageSpendBot
MANAGE_SPEND_BOT_NOTIFICATIONS_ENABLED=true
STUDENT_WELCOME_MESSAGE_ENABLED=true
GOOGLE_AUTH_MODE=oauth
GOOGLE_CREDENTIALS_FILE=config/google-credentials.json
GOOGLE_TOKEN_FILE=config/google-token.json
GOOGLE_CALENDAR_ID=primary
# Optional only when GOOGLE_AUTH_MODE=service_account.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=config/google-service-account.json
CALENDAR_SYNC_INTERVAL_MINUTES=10
CALENDAR_SYNC_LOOKAHEAD_DAYS=30
CALENDAR_SYNC_LOOKBACK_DAYS=7
LESSONS_ADMIN_PAST_DAYS=7
LESSONS_ADMIN_FUTURE_DAYS=7
REMINDER_DRY_RUN=
RECEIPT_CLEANUP_ENABLED=true
RECEIPT_RETENTION_DAYS=7
RECEIPT_TMP_RETENTION_DAYS=1
RECEIPT_CLEANUP_DIR=data/receipts
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_MODEL=openrouter/free
LOCAL_SOCKS_PROXY=socks5h://127.0.0.1:12334
# Local full test student. Used only by npm run seed:test-student.
TEST_STUDENT_NAME_RU=
TEST_STUDENT_NAME_AR= 
TEST_STUDENT_TELEGRAM_USERNAME=@
TEST_STUDENT_CALENDAR_KEYWORD=
TEST_STUDENT_LESSON_PRICE_AMOUNT=1500
TEST_STUDENT_LESSON_PRICE_CURRENCY=RUB
