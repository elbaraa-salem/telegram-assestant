{
  "name": "telegram-assestant",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "npm run start:web",
    "send:test": "tsx src/scripts/sendTestMessage.ts",
    "send:reminders": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/services/reminderService.ts",
    "send:reminders:prod": "APP_MODE=production ENABLE_TEST_SEED=false NODE_OPTIONS=--dns-result-order=ipv4first tsx src/services/reminderService.ts",
    "listen:telegram": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/services/telegramListener.ts",
    "build:css": "sass src/web/public/styles/main.scss src/web/public/styles/main.css",
    "build:server": "tsc -p tsconfig.server.json && node scripts/fix-dist-esm-imports.mjs",
    "build:production": "npm run typecheck && npm run build:css && npm run build:server",
    "watch:css": "sass --watch src/web/public/styles/main.scss src/web/public/styles/main.css",
    "admin": "npm run start:web",
    "start:web": "npm run build:css && tsx src/web/server.ts",
    "start:web:prod": "APP_MODE=production ENABLE_TEST_SEED=false CALENDAR_SYNC_ON_WEB_START=false tsx src/web/server.ts",
    "start:production": "APP_MODE=production ENABLE_TEST_SEED=false tsx src/scripts/startProduction.ts",
    "sync:telegram-ids": "tsx src/scripts/syncTelegramIds.ts",
    "reset:all": "npm run reset:local-data",
    "reset:local-data": "tsx src/scripts/resetAllData.ts",
    "seed:test-student": "ENABLE_TEST_SEED=true tsx src/scripts/seedTestStudent.ts",
    "google:auth": "tsx src/scripts/googleAuth.ts",
    "sync:calendar": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/services/calendarSync.ts",
    "sync:calendar:prod": "APP_MODE=production ENABLE_TEST_SEED=false NODE_OPTIONS=--dns-result-order=ipv4first tsx src/services/calendarSync.ts",
    "sync:calendar:scheduler": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/services/calendarSyncScheduler.ts",
    "sync:calendar:scheduler:prod": "APP_MODE=production ENABLE_TEST_SEED=false NODE_OPTIONS=--dns-result-order=ipv4first tsx src/services/calendarSyncScheduler.ts",
    "sync:calendar:dry": "NODE_OPTIONS=--dns-result-order=ipv4first CALENDAR_SYNC_DRY_RUN=true tsx src/services/calendarSync.ts",
    "cleanup:receipts": "tsx src/scripts/cleanupReceipts.ts",
    "cleanup:receipts:prod": "node dist/scripts/cleanupReceipts.js",
    "dev:full-test": "bash scripts/dev-full-test.sh",
    "test:openrouter": "tsx src/scripts/testOpenRouter.ts",
    "test:reply-ai": "tsx src/scripts/testStudentReplyAi.ts",
    "test:lesson-cancellation": "tsx src/scripts/testLessonCancellationWorkflow.ts",
    "test:manage-spend-notifier": "tsx src/scripts/testManageSpendNotifier.ts",
    "test:production-setup": "tsx src/scripts/testProductionSetup.ts",
    "test:student-welcome": "tsx src/scripts/testStudentWelcome.ts",
    "test:student-message-handling": "tsx src/scripts/testStudentMessageHandling.ts",
    "test:reminder-binding": "tsx src/scripts/testReminderLessonBinding.ts",
    "test:receipt-cleanup": "tsx src/scripts/testCleanupReceipts.ts",
    "test:local-receipt-parser": "tsx src/scripts/testLocalReceiptParser.ts",
    "test:receipt-idempotency": "tsx src/scripts/testReceiptIdempotency.ts",
    "test:pdf-text": "tsx src/scripts/extractReceiptText.ts",
    "test:receipt-ai": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/scripts/analyzeReceiptWithAi.ts",
    "test:receipt-ai-db": "tsx src/scripts/testReceiptAiDb.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "input": "^1.0.1",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "sass": "^1.99.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
