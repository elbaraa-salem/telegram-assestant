<section class="page-header">
  <h1>Lessons</h1>
  <p class="help-text">
    Showing lessons from <%= range.fromDate || "any date" %> to <%= range.toDate || "future" %>
  </p>
</section>

<section class="toolbar">
  <a class="button button-secondary" href="/lessons?range=previous">Previous week</a>
  <a class="button button-secondary" href="/lessons">Current range</a>
  <a class="button button-secondary" href="/lessons?range=next">Next week</a>
  <a class="button button-secondary" href="/lessons?range=all-future">Show all future</a>
  <form class="inline-form" method="get" action="/lessons">
    <input type="hidden" name="range" value="custom">
    <input name="from" type="date" value="<%= range.fromDate || "" %>">
    <input name="to" type="date" value="<%= range.toDate || "" %>">
    <button class="button" type="submit">Custom date range</button>
  </form>
</section>

<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <!-- <th>Title</th> -->
      <th>Student</th>
      <th>Start time</th>
      <th>Status</th>
      <th>Student response</th>
      <th>Cancellation reason</th>
      <th>Payment status</th>
      <!-- <th>Payment method</th>
      <th>Package progress</th> -->
      <th>AI receipt analysis</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% lessons.forEach((lesson) => { %>
      <tr>
        <td><%= lesson.id %></td>
        <!-- <td><%= lesson.title %></td> -->
        <td><%= lesson.name_ru %></td>
        <td>
          <%= lesson.formattedStartTime.date %><br>
          <%= lesson.formattedStartTime.time %>
        </td>
        <td>
          <%= lesson.displayStatus %>
          <% if (lesson.isGoogleDeleted) { %>
            <br><span class="help-text">Deleted from Google Calendar</span>
          <% } %>
        </td>
        <td><%= lesson.student_response %></td>
        <td>
          <% if (lesson.cancellation_source) { %>
            Cancellation source: <%= lesson.cancellation_source %><br>
          <% } %>
          <% if (lesson.cancellation_reason) { %>
            <div class="notice notice-warning">
              <strong>Student requested cancellation</strong><br>
              Reason: <%= lesson.cancellation_reason %>
              <% if (lesson.cancellation_requested_at) { %>
                <br>Requested at: <%= lesson.cancellation_requested_at %>
              <% } %>
            </div>
            <!-- Cancellation requested at: <%= lesson.cancellation_requested_at %> -->
          <% } else if (lesson.hasCancellationRequest) { %>
            <div class="notice notice-warning">
              <strong>Student requested cancellation</strong><br>
              Waiting for reason.
            </div>
          <% } %>
        </td>
        <td>
          <%= lesson.payment_status === "paid" ? "paid / covered by balance" : (lesson.payment_status || "") %>
          <% if (lesson.charge_amount !== null) { %>
            <br><%= lesson.charge_paid_amount %> / <%= lesson.charge_amount %>
          <% } %>
        </td>
        <!-- <td><%= lesson.payment_method %></td>
        <td><%= lesson.packageProgress %></td> -->
        <td>
          <% if (!lesson.aiReceipt.hasReceipt) { %>
            No receipt
          <% } else if (!lesson.aiReceipt.hasAiResult) { %>
            Receipt received, AI analysis not available yet.
          <% } else if (lesson.aiReceipt.parseFailed) { %>
            <div class="ai-receipt">
              <strong>AI receipt analysis</strong><br>
              Raw result: <%= lesson.aiReceipt.rawResult %>
            </div>
          <% } else { %>
            <div class="ai-receipt">
              <!-- <strong>AI receipt analysis</strong><br> -->
              Confirmed: <%= lesson.aiReceipt.paymentConfirmed ? "yes" : "no" %><br>
              Amount: <%= lesson.aiReceipt.amount %> <%= lesson.aiReceipt.currency %><br>
              Date: <%= lesson.aiReceipt.paymentDate %><br>
              <!-- Confidence: <%= lesson.aiReceipt.confidence %><br> -->
              <!-- Reason: <%= lesson.aiReceipt.reason %> -->
            </div>
          <% } %>
        </td>
        <td class="actions">
          <% if (lesson.canComplete) { %>
            <form method="post" action="/lessons/<%= lesson.id %>/complete">
              <button class="button" type="submit">تم الدرس</button>
            </form>
          <% } %>
          <% if (lesson.canCancel) { %>
            <a class="button button-danger" href="/lessons/<%= lesson.id %>/cancel">إلغاء الدرس</a>
          <% } %>
          <% if (lesson.payment_status === "paid") { %>
            مدفوع
          <% } else if (lesson.canConfirmPayment) { %>
            <form method="post" action="/lessons/<%= lesson.id %>/confirm-payment">
              <button class="button" type="submit">الدرس تم دفعه</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
