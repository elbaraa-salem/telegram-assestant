<section class="page-header">
  <h1>Students</h1>
  <% if (warning) { %>
    <div class="notice notice-warning"><%= warning %></div>
  <% } %>
</section>

<section class="form-grid">
  <form class="card form" method="post" action="/students">
    <h2>Add student</h2>
    <label>Russian name <input name="name_ru"></label>
    <label>Arabic name <input name="name_ar"></label>
    <label>Telegram username <input name="telegram_username"></label>
    <label>Telegram ID <input name="telegram_id"></label>
    <p class="help-text">Optional. If empty, it will be resolved automatically from Telegram username or first message.</p>
    <label>Calendar keyword <input name="calendar_keyword" required></label>
    <label>Lesson price <input name="lesson_price_amount" type="number" min="0" step="1" value="0" required></label>
    <label>Currency <input name="lesson_price_currency" value="RUB" required></label>
    <button class="button" type="submit">Create student</button>
  </form>

  <form id="manual-payment" class="card form" method="post" action="/manual-payments">
    <h2>Add manual payment</h2>
    <label>Student
      <select name="student_id" required>
        <option value="">Choose student</option>
        <% students.forEach((student) => { %>
          <option value="<%= student.id %>">
            <%= student.id %> — <%= student.name_ru %> — <%= student.name_ar %> — <%= student.telegram_username || "" %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>Amount <input name="amount" type="number" min="1" step="1" required></label>
    <label>Currency <input name="currency" value="RUB" required></label>
    <button class="button" type="submit">Add payment</button>
  </form>

  <form id="manual-debt" class="card form" method="post" action="/manual-debts">
    <h2>Add debt</h2>
    <label>Student
      <select name="student_id" required>
        <option value="">Choose student</option>
        <% students.forEach((student) => { %>
          <option value="<%= student.id %>">
            <%= student.id %> — <%= student.name_ru %> — <%= student.name_ar %> — <%= student.telegram_username || "" %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>Amount <input name="amount" type="number" min="1" step="1" required></label>
    <label>Currency <input name="currency" value="RUB" required></label>
    <label>Reason / note <textarea name="note" rows="3"></textarea></label>
    <button class="button button-danger" type="submit">Add debt</button>
  </form>
</section>

<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Name RU</th>
      <th>Name AR</th>
      <th>Telegram username</th>
      <!-- <th>Telegram ID</th> -->
      <!-- <th>Calendar keyword</th> -->
      <th>Lesson price</th>
      <th>Active</th>
      <!-- <th>Created</th> -->
      <th>Debt</th>
      <th>Prepaid balance</th>
      <th>Welcome</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% students.forEach((student) => { %>
      <tr>
        <td><%= student.id %></td>
        <td><%= student.name_ru %></td>
        <td><%= student.name_ar %></td>
        <td><%= student.telegram_username %></td>
        <!-- <td><%= student.telegram_id %></td> -->
        <!-- <td><%= student.calendar_keyword %></td> -->
        <td><%= student.lesson_price_amount %> <%= student.lesson_price_currency %></td>
        <td><%= student.is_active ? "active" : "inactive" %></td>
        <!-- <td><%= student.created_at %></td> -->
        <td>
          <%= student.balance.unpaid_lessons_count %> lessons<br>
          <%= student.balance.unpaid_amount %> <%= student.balance.currency %>
        </td>
        <td>
          <%= student.balance.prepaid_lessons_count %> lessons<br>
          <%= student.balance.prepaid_amount %> <%= student.balance.currency %>
        </td>
        <td>
          <% if (student.welcome_message_sent_at) { %>
            Sent<br>
            <%= student.welcome_message_sent_at %>
          <% } else if (student.welcome_message_error) { %>
            Failed<br>
            <%= student.welcome_message_error %>
          <% } else { %>
            Not sent
          <% } %>
        </td>
        <td class="actions">
          <a class="button button-secondary" href="/students/<%= student.id %>/edit">Edit</a>
          <form method="post" action="/students/<%= student.id %>/sync-calendar">
            <button class="button" type="submit">Sync calendar</button>
          </form>
          <% if (!student.welcome_message_sent_at) { %>
            <form method="post" action="/students/<%= student.id %>/send-welcome">
              <button class="button" type="submit">Send welcome message</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
